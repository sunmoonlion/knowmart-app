{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowmart/knowbot/v2/knowbot-manifest.schema.json",
  "$defs": {
    "DataNeed": {
      "additionalProperties": false,
      "description": "声明模板里的一样：类型（细类，或只写大类）、期间规则、版本形态、格式、份数、\n必填、要的读法、来源限制、多候选时的优先策略、表格类的表与列；事项与行业写了就是\n缩小范围；口径与说明只展示。",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "doc_type": {
          "enum": [
            "disclosure",
            "research",
            "news",
            "briefing",
            "policy",
            "statistics",
            "other",
            "annual_report",
            "semiannual_report",
            "q1_report",
            "q3_report",
            "interim_announcement",
            "prospectus",
            "listing_announcement",
            "ir_activity",
            "ir_qa",
            "research_morning",
            "research_macro",
            "research_strategy",
            "research_industry",
            "research_company",
            "research_quant",
            "research_market",
            "research_fixed_income",
            "research_commodity",
            "research_derivatives",
            "research_fund",
            "research_fx",
            "research_reits",
            "research_esg",
            "research_other",
            "financial_news",
            "recommended_news",
            "negative_news",
            "brief",
            "law",
            "administrative_regulation",
            "departmental_rule",
            "normative_document",
            "local_regulation",
            "judicial_interpretation",
            "policy_interpretation",
            "business_rule",
            "regulatory_letter",
            "statistical_bulletin",
            "statistical_data",
            "census",
            "webpage",
            "other_table",
            "other_text"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/PeriodRule"
        },
        "formats": {
          "items": {
            "enum": [
              "pdf",
              "excel",
              "csv",
              "text",
              "markdown",
              "html"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "min_count": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Min Count",
          "type": "integer"
        },
        "max_count": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Count",
          "type": "integer"
        },
        "reading": {
          "default": "original",
          "enum": [
            "original",
            "text",
            "pages",
            "table"
          ],
          "title": "Reading",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "enum": [
              "disclosure",
              "collected",
              "upload",
              "output"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Sources",
          "type": "array"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "public_first",
                "upload_first",
                "newest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataTable"
          },
          "maxItems": 20,
          "title": "Tables",
          "type": "array"
        },
        "caliber": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caliber"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "edition": {
          "default": "full",
          "enum": [
            "full",
            "summary",
            "english"
          ],
          "title": "Edition",
          "type": "string"
        },
        "topics": {
          "default": [],
          "items": {
            "enum": [
              "results",
              "ipo",
              "refinancing",
              "dividend",
              "meetings",
              "governance",
              "operations",
              "restructuring",
              "equity",
              "trading",
              "intermediary",
              "supervision"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Topics",
          "type": "array"
        },
        "industry": {
          "anyOf": [
            {
              "enum": [
                "石油石化",
                "煤炭",
                "有色金属",
                "电力及公用事业",
                "钢铁",
                "基础化工",
                "建筑",
                "建材",
                "轻工制造",
                "机械",
                "电力设备",
                "国防军工",
                "汽车",
                "商贸零售",
                "消费者服务",
                "家电",
                "纺织服装",
                "医药",
                "食品饮料",
                "农林牧渔",
                "银行",
                "非银行金融",
                "房地产",
                "交通运输",
                "电子元器件",
                "通信",
                "计算机",
                "传媒",
                "综合"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        }
      },
      "required": [
        "key",
        "name",
        "doc_type",
        "period",
        "formats"
      ],
      "title": "DataNeed",
      "type": "object"
    },
    "DataTable": {
      "additionalProperties": false,
      "description": "表格类数据要有的一张表与几列（按表头的字认，不按位置）；CSV 不写表名。",
      "properties": {
        "sheet": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "columns": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "columns"
      ],
      "title": "DataTable",
      "type": "object"
    },
    "FrozenBinding": {
      "additionalProperties": false,
      "description": "作者绑给这位专家、交付时冻结的一份（SDD 0043 第 4.4 节）。\n\n数据留在 knowbase，这里只记引用：哪份资料、哪一版与摘要（要读法的再钉读法），\n凭的是 `expert:<专家>@<版本>`；别人请这位专家时按受益人授权读。",
      "properties": {
        "need": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Need"
        },
        "material_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "version_no": {
          "minimum": 1,
          "title": "Version No",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "rendition_kind": {
          "anyOf": [
            {
              "enum": [
                "text",
                "pages",
                "table",
                "index",
                "parse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Kind"
        },
        "rendition_no": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition No"
        },
        "rendition_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Sha256"
        },
        "basis_ref": {
          "pattern": "^expert:[A-Za-z0-9._-]{1,64}@[0-9][0-9.]{0,31}$",
          "title": "Basis Ref",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "version_no",
        "sha256",
        "basis_ref"
      ],
      "title": "FrozenBinding",
      "type": "object"
    },
    "PeriodRule": {
      "additionalProperties": false,
      "description": "固定期间（start、end）；定期报告最近 N 个完整的报告期（latest + count，\n可加截至任务日期已披露）；其余类型最近 N 个月内披露的（recent + months），\n或不限期间（none）。定期报告的期间是报告期，其余类型的期间是披露时间窗\n（SDD 0049）。",
      "properties": {
        "kind": {
          "enum": [
            "fixed",
            "latest",
            "recent",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "count": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "disclosed_by_task_date": {
          "default": false,
          "title": "Disclosed By Task Date",
          "type": "boolean"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Months"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PeriodRule",
      "type": "object"
    },
    "RuleSource": {
      "additionalProperties": false,
      "description": "一条判断规则出自哪里（C-L1：投资逻辑只来自用户）。",
      "properties": {
        "rule": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "source": {
          "enum": [
            "user_text",
            "user_confirmed"
          ],
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "source",
        "ref"
      ],
      "title": "RuleSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "清单 v2（SDD 0043 第三、四节）：数据需求声明换成 v2（knowbase 的契约），\n作者绑定的数据只带冻结的引用；不再有 knowlab 数据集的绑定。",
  "properties": {
    "schema": {
      "const": "knowbot-manifest/v2",
      "title": "Schema",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "tagline": {
      "default": "",
      "maxLength": 200,
      "title": "Tagline",
      "type": "string"
    },
    "version": {
      "pattern": "^[1-9][0-9]{0,5}$",
      "title": "Version",
      "type": "string"
    },
    "runtime": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "title": "Runtime",
      "type": "string"
    },
    "pack": {
      "additionalProperties": true,
      "title": "Pack",
      "type": "object"
    },
    "data_needs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DataNeed"
      },
      "maxItems": 20,
      "title": "Data Needs",
      "type": "array"
    },
    "bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FrozenBinding"
      },
      "maxItems": 200,
      "title": "Bindings",
      "type": "array"
    },
    "rule_sources": {
      "items": {
        "$ref": "#/$defs/RuleSource"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Rule Sources",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "name",
    "version",
    "runtime",
    "pack",
    "rule_sources"
  ],
  "title": "knowbot-manifest v2 (outer envelope; `pack` is owned by the executor)",
  "type": "object"
}
